{
  "doctype": "DocType",
  "name": "PZ Contract Item",
  "module": "Sales Contracts",
  "custom": 0,
  "istable": 1,
  "engine": "InnoDB",
  "field_order": [
    "item_code",
    "item_name",
    "description",
    "grade_master",
    "grade",
    "packaging",
    "qty",
    "uom",
    "conversion_factor",
    "rate",
    "amount"
  ],
  "fields": [
    {
      "fieldname": "item_code",
      "label": "Item",
      "fieldtype": "Link",
      "options": "Item",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "item_name",
      "label": "Item name",
      "fieldtype": "Data",
      "read_only": 1
    },
    {
      "fieldname": "description",
      "label": "ERP description",
      "fieldtype": "Small Text",
      "read_only": 1
    },
    {
      "fieldname": "grade_master",
      "label": "Grade",
      "fieldtype": "Link",
      "options": "Bitumen Grade",
      "in_list_view": 1,
      "description": "Choose the active Grade master for this contract line."
    },
    {
      "fieldname": "grade",
      "label": "Historical Grade snapshot",
      "fieldtype": "Data",
      "read_only": 1,
      "depends_on": "eval:doc.grade && !doc.grade_master",
      "description": "Preserves the free-text Grade recorded on contracts created before Grade master links were introduced."
    },
    {
      "fieldname": "packaging",
      "label": "Derived packaging snapshot",
      "fieldtype": "Data",
      "hidden": 1,
      "read_only": 1,
      "description": "Derived server-side from verified Item naming and retained for historical contract prints."
    },
    {
      "fieldname": "qty",
      "label": "Quantity",
      "fieldtype": "Float",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "uom",
      "label": "UOM",
      "fieldtype": "Link",
      "options": "UOM",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "conversion_factor",
      "label": "Stock UOM factor",
      "fieldtype": "Float",
      "read_only": 1
    },
    {
      "fieldname": "rate",
      "label": "Rate",
      "fieldtype": "Currency",
      "options": "parent.currency",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "amount",
      "label": "Amount",
      "fieldtype": "Currency",
      "options": "parent.currency",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "specification_reference",
      "label": "Certificate / agreed specification reference",
      "fieldtype": "Data",
      "hidden": 1,
      "read_only": 1
    }
  ],
  "permissions": [],
  "track_changes": 1
}
