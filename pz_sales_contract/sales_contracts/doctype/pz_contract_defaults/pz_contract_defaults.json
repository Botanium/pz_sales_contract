  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "print": 0,
      "email": 0,
      "export": 0
    }
  ],
  "track_changes": 1,
  "autoname": "field:company",
